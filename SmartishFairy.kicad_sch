	)
	(text "5 V logic buck: LM5164, fSW = Vout x 2500 / RON ~ 320 kHz, Type-3 ripple network (RA/CA/CB), UVLO on at ~9.5 V.\nVout = 5.3 V (R49 187k / R50 54.9k) so that behind the output diodes the 74AHCT buffer and ESP module still see >= 4.5 V.\nL5_SW -> 33uH -> 5V_MAIN (-> system 5 V via diode, and ESP via diode)."
		(exclude_from_sim no)
		(at 30 308 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "43c53730-40a0-4ba4-933b-cd0e5492a8a0")
	)
