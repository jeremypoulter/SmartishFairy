	(label "HV_SENSE"
		(at 491.49 87.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "45bdc245-0404-403a-b825-0b106679d901")
	)
	(text "MAIN_IN (12-50 V) = Data_In pin 4 or Main_In terminal, diode-OR-ed (reverse-polarity protection).\nTVS is DNP: fit SMBJ28A only on 12-24 V builds (no TVS can protect 60 V parts above ~33 V).\nF1 (PTC rated >= 60 V; choose the part and check its fault-current rating) protects the Data_Out pin 4 pass-through.\nHVBUS = MAIN_IN through SS310 (pass-through) and/or the boost converter. Each driver sheet takes HVBUS and makes VS either with its own\nLM5164 buck (set by the DAC) or with a 0R bypass link - never both. DEFAULT POPULATION: pass-through + bypass links; the buck parts inside the\ndriver sheet and the boost block (U12) are DNP, with their strap resistors, so the firmware reads them as not fitted."
		(exclude_from_sim no)
		(at 299.72 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "928f4eaa-d885-433f-b8d7-1ee6b31b9ca1")
	)
