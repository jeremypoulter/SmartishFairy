	(text "5 V logic buck: LM5164, fSW = Vout x 2500 / RON ~ 320 kHz, Type-3 ripple network (RA/CA/CB), UVLO on at ~9.5 V.\nVout = 5.3 V (R49 187k / R50 54.9k) so that behind the output diodes the 74AHCT buffer and ESP module still see >= 4.5 V.\nL1 -> 5V_MAIN -> D20 -> system 5 V (also fed from USB through D18) and D21 -> ESP module only."
		(exclude_from_sim no)
		(at 299.72 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba23e34f-90a1-4014-9e00-55a1e0b84d76")
	)
